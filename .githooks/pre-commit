#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# The root pnpm install does not install the classifier's separate package.
printf '%s\n' '[pre-commit] Installing locked classifier dependencies, including native image support.' >&2
install_status=0
npm ci --prefix infrastructure/photo-classifier --include=optional || install_status=$?
if [ "$install_status" -ne 0 ]; then
  printf '%s\n' '[pre-commit] Classifier dependency installation failed. Fix the install before committing.' >&2
  exit "$install_status"
fi
# Run the full local suite, including the component/test pairing check.
printf '%s\n' '[pre-commit] Running the full local test suite.' >&2
test_status=0
pnpm test || test_status=$?
if [ "$test_status" -ne 0 ]; then
  printf '%s\n' '[pre-commit] Tests failed. Fix the reported failures before committing.' >&2
  exit "$test_status"
fi
printf '%s\n' '[pre-commit] All local tests passed.' >&2
